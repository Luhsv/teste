<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador Aleatório ✨</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #7b2cff, #ff4fd8);
            color: white;
        }

        .container {
            width: 90%;
            max-width: 600px;
            padding: 40px;
            text-align: center;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 25px;
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        h1 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        p {
            opacity: 0.8;
            margin-bottom: 30px;
        }

        #frase {
            min-height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        button {
            border: none;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            background: white;
            color: #7b2cff;
            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.08);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        footer {
            margin-top: 30px;
            font-size: 13px;
            opacity: 0.6;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>✨ Frase Aleatória</h1>

        <p>Clique no botão e descubra uma frase completamente aleatória.</p>

        <div id="frase">
            Clique no botão abaixo 👇
        </div>

        <button onclick="gerarFrase()">
            Gerar frase 🎲
        </button>

        <footer>
            Feito para absolutamente nenhum motivo.
        </footer>

    </div>

    <script>
        const frases = [
            "Hoje é um ótimo dia para comer pizza 🍕",
            "Você provavelmente deveria estar dormindo 😴",
            "A vida fica melhor com música 🎧",
            "Talvez você precise de umas férias 🏖️",
            "Um gato provavelmente está julgando você agora 🐈",
            "Nunca subestime o poder de um lanche 🍔",
            "O universo está fazendo alguma coisa... provavelmente.",
            "Você acaba de perder 5 segundos lendo isso.",
            "Se ninguém acredita em você, acredite em você mesmo ✨",
            "Talvez a resposta seja simplesmente: sim.",
            "Hoje parece um ótimo dia para fazer algo aleatório 🎲",
            "Você deveria beber água 💧"
        ];

        function gerarFrase() {
            const indice = Math.floor(Math.random() * frases.length);
            document.getElementById("frase").textContent = frases[indice];
        }
    </script>

</body>
</html>
